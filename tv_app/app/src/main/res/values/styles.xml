<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base Application Theme -->
    <style name="Theme.FamilyHubTV" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Fullscreen Immersive TV Theme -->
    <style name="Theme.FamilyHubTV.Fullscreen" parent="Theme.FamilyHubTV">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!-- TV Button Style with Focus Indicator -->
    <style name="Widget.FamilyHubTV.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/selector_tv_button</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">false</item>
    </style>

</resources>
