# ==============================================================================
# Cookbook App Production Configuration Template (.env.example)
#
# Copy this file to '.env' in the same directory and configure the variables:
#   $ cp .env.example .env
# ==============================================================================

# Node Environment
# Tells Express to run in production mode (enables performance optimization)
NODE_ENV=production

# Internally exposed port for the application (default is 5000)
# Make sure to match the internal port mapped in docker-compose.yml
PORT=5000

# JSON Web Token Secret
# CRITICAL: Change this to a secure, random, long secret key for production!
# If left blank, the app will generate a random secret on startup.
# However, this means users will be logged out EVERY time the server restarts.
# You can generate a secure secret using:
#   $ openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_signing_key_here

# Persistent Storage Configurations
# Inside the Docker container, user uploads and the database are stored in /data.
# Do not modify these unless you are customizing the Docker image directories.
DATA_DIR=/data
DATABASE_PATH=/data/cookbook.db
